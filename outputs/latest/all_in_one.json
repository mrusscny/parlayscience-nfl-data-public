    "label": "2026-week-03"
  },
  "method": {
    "structure": "four categories, four picks each",
    "derivation": "Digest. Touchdown/Rushing/Receiving inherit eligibility from touchdown_radar, rb_spotlight and wr_spotlight and are re-ranked on the market-specific rate. Passing Yards is built here from _passer_metrics; no V1 concept produced it.",
    "scoring_mode": "generated_target",
    "scoring_caveat": "Each target is the largest rung the projection clears with probability >= p_target, under a lognormal fitted to the player's own mean and shrunk per-game spread. Where Kalshi lists the player, the rungs scanned are its REAL listed contracts and book_verified is true -- the reader can trade that exact number. Where it does not, the ladder is synthetic and book_verified is false: treat those as illustrative, because a number no exchange offers cannot be bet.",
    "odds": {
      "source": "Kalshi public market data (no auth required)",
      "enabled": true,
      "series": {
        "pass_yards": "KXNFLPASSYDS",
        "rush_yards": "KXNFLRSHYDS",
        "rec_yards": "KXNFLRECYDS"
      },
      "coverage": {
        "pass_yards": "30 players, 242 rungs, 242 priced (books open)",
        "rush_yards": "77 players, 658 rungs, 658 priced (books open)",
        "rec_yards": "154 players, 1163 rungs, 1163 priced (books open)"
      },
      "note": "Coverage is partial and deepens as kickoff approaches. A player the exchange does not list falls back to the synthetic grid rather than being dropped."
    },
    "started_games_excluded": true,
    "started_games_note": "Week 1 opens on a Wednesday, so by the Sunday run the Wed/Thu/Sat props are already settled. Players whose kickoff has passed are excluded outright.",
    "generated_at_et": "2026-09-26T12:29:20-04:00",
    "p_target": {
      "pass_yards": 0.7,
      "rush_yards": 0.7,
      "rec_yards": 0.7
    },
    "target_grid_step": {
      "pass_yards": 25.0,
      "rush_yards": 10.0,
      "rec_yards": 10.0
    },
    "distribution": "lognormal by method of moments; Poisson for Anytime TD. scipy is not a dependency, so the survival function is math.erfc and the ladder is scanned rather than inverted.",
    "variance": {
      "source": "nfl_data.get_player_stats (weekly box scores)",
      "seasons_pooled": [
        2025,
        2026
      ],
      "shrink_k": 4,
      "markets": {
        "pass_yards": "103 players; market-typical cv 0.329",
        "rush_yards": "367 players; market-typical cv 0.766",
        "rec_yards": "554 players; market-typical cv 0.807"
      }
    },
    "backtested": false,
    "backtest_note": "Unlike the five V1 concepts, this sheet has not been measured against holdout weeks. Do not present its ordering as validated.",
    "weights": {
      "touchdown": {
        "xtd_per_game": 1.0
      },
      "passing_yards": {
        "pass_yards_pg": 1.0
      },
      "rushing_yards": {
        "rush_yards_pg": 1.0
      },
      "receiving_yards": {
        "rec_yards_pg": 1.0
      }
    },
    "blend": {
      "prior": 0.7,
      "current": 0.3
    },
    "constraints": {
      "max_per_team": 2,
      "cross_category_dedupe": true,
      "category_priority": [
        "touchdown",
        "passing_yards",
        "rushing_yards",
        "receiving_yards"
      ],
      "rookie_policy": "inherit",
      "rookie_note": "Inherited. Three of four categories take their pool from boards that already applied ROOKIE_ELIGIBLE_WEEK=3, so rookies cannot be admitted early without changing SpotlightConfig -- shared code the live sheets depend on. Only Passing Yards is gated here."
    },
    "qb_eligibility": {
      "min_games_played": 4,
      "min_pass_attempts_pg": 18.0,
      "validated": false
    }
  },
