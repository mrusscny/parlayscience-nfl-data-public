  "concept": "all_in_one",
  "title": "All In One Stat Sheet",
  "primary_markets": [
    "Anytime TD",
    "Passing Yards",
    "Rush Yards",
    "Receiving Yards"
  ],
  "week": {
    "season": 2026,
    "week": 1,
    "prior_season": 2025,
    "is_preseason": true,
    "completed_weeks": 0,
    "first_kickoff": "2026-09-09",
    "last_game": "2026-09-14",
    "generated_at_et": "2026-09-02T18:10:33-04:00",
    "label": "2026-week-01"
  },
  "method": {
    "structure": "four categories, four picks each",
    "derivation": "Digest. Touchdown/Rushing/Receiving inherit eligibility from touchdown_radar, rb_spotlight and wr_spotlight and are re-ranked on the market-specific rate. Passing Yards is built here from _passer_metrics; no V1 concept produced it.",
    "scoring_mode": "generated_target",
    "scoring_caveat": "Targets are GENERATED, not pulled from a sportsbook. Each is the largest rung on the market's ladder that the projection clears with probability >= p_target, under a lognormal fitted to the player's own mean and shrunk per-game spread. No book has confirmed these numbers: book_line is null and book_verified is false on every pick. A target no book offers cannot be bet, so wire src/sources/odds.py before presenting these as playable.",
    "p_target": {
      "pass_yards": 0.7,
      "rush_yards": 0.7,
      "rec_yards": 0.7
    },
    "target_grid_step": {
      "pass_yards": 25.0,
      "rush_yards": 10.0,
      "rec_yards": 10.0
    },
    "distribution": "lognormal by method of moments; Poisson for Anytime TD. scipy is not a dependency, so the survival function is math.erfc and the ladder is scanned rather than inverted.",
    "variance": {
      "source": "nfl_data.get_player_stats (weekly box scores)",
      "seasons_pooled": [
        2025,
        2026
      ],
      "shrink_k": 4,
      "markets": {
        "pass_yards": "96 players; market-typical cv 0.330",
        "rush_yards": "335 players; market-typical cv 0.772",
        "rec_yards": "502 players; market-typical cv 0.805"
      }
    },
    "backtested": false,
    "backtest_note": "Unlike the five V1 concepts, this sheet has not been measured against holdout weeks. Do not present its ordering as validated.",
    "weights": {
      "touchdown": {
        "xtd_per_game": 1.0
      },
      "passing_yards": {
        "pass_yards_pg": 1.0
      },
      "rushing_yards": {
        "rush_yards_pg": 1.0
      },
      "receiving_yards": {
        "rec_yards_pg": 1.0
      }
    },
    "blend": {
      "prior": 1.0,
      "current": 0.0
    },
    "constraints": {
      "max_per_team": 2,
      "cross_category_dedupe": true,
      "category_priority": [
        "touchdown",
        "passing_yards",
        "rushing_yards",
        "receiving_yards"
      ],
      "rookie_policy": "inherit",
      "rookie_note": "Inherited. Three of four categories take their pool from boards that already applied ROOKIE_ELIGIBLE_WEEK=3, so rookies cannot be admitted early without changing SpotlightConfig -- shared code the live sheets depend on. Only Passing Yards is gated here."
    },
    "qb_eligibility": {
      "min_games_played": 4,
      "min_pass_attempts_pg": 18.0,
      "validated": false
    }
  },
